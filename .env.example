# --- Core ---------------------------------------------------------------
# Leave DATABASE_URL empty to build entirely from the static data in src/data.
DATABASE_URL=""
NEXT_PUBLIC_SITE_URL="https://www.jabsandtabs.com"

# --- Compliance feature flags (ALL default to false) ----------------------
# Do not set any of these to "true" without written sign-off from a UK
# regulatory/legal adviser, recorded in docs/compliance/SIGN-OFF.md.
FLAG_POM_PRICING="false"
FLAG_AFFILIATE_LINKS="false"
FLAG_DISCOUNT_CODES="false"
FLAG_STICKY_CTA="false"
# Never enable in production.
FLAG_SHOW_UNREVIEWED_CONTENT="false"

# Include content/articles/_*.mdx sample files (local testing only).
INCLUDE_SAMPLE_CONTENT="false"

# --- Admin (HTTP Basic Auth for /admin) ------------------------------------
# If either is empty, /admin is disabled entirely.
ADMIN_USER=""
ADMIN_PASSWORD=""
